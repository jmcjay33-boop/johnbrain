<footer
  id="footer-section"
  class="w-full bg-slate-950 text-slate-500 py-12 border-t border-slate-900 font-sans"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- TOP ROW: Regulatory & Investor Protection Links -->
    <div class="flex flex-wrap items-center justify-center md:justify-between gap-4 pb-6 border-b border-slate-900 text-xs sm:text-sm font-medium text-slate-400">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-x-6 gap-y-2">
        <a
          href="/regdisc#risk-warnings"
          class="hover:text-[#B7F000] transition-colors"
          data-cursor="selectable"
        >
          Risk Warning
        </a>
        <a
          href="/regdisc#protection-disclaimer"
          class="hover:text-[#B7F000] transition-colors"
          data-cursor="selectable"
        >
          Investor Protection Disclaimer
        </a>
        <a
          href="/regdisc#investor-rights"
          class="hover:text-[#B7F000] transition-colors"
          data-cursor="selectable"
        >
          Investor Rights
        </a>
        <a
          href="/regdisc#access-criteria"
          class="hover:text-[#B7F000] transition-colors"
          data-cursor="selectable"
        >
          Access Criteria
        </a>
        <a
          href="/regdisc#fees"
          class="hover:text-[#B7F000] transition-colors"
          data-cursor="selectable"
        >
          Fees &amp; Charges
        </a>
        <a
          href="/regdisc#complaints"
          class="hover:text-[#B7F000] transition-colors"
          data-cursor="selectable"
        >
          Complaints Procedure
        </a>
        <a
          href="/regdisc#contingency"
          class="hover:text-[#B7F000] transition-colors"
          data-cursor="selectable"
        >
          Business Continuity
        </a>
      </div>
    </div>

    <!-- MIDDLE ROW: Brief Risk Summary Notice -->
    <p class="text-xs text-slate-500 leading-relaxed text-center md:text-left">
      <strong class="text-slate-400">Risk Warning:</strong> Digital assets and related services involve a high degree of risk and you may lose some or all of the money or digital assets you invest or deposit. Losses are not covered by any Investor Protection Fund. Please read our full{' '}
      <a
        href="/regdisc"
        class="text-[#B7F000] hover:underline"
        data-cursor="selectable"
      >
        Regulatory Disclosures &amp; Investor Protection
      </a>{' '}
      before participating.
    </p>

    <!-- BOTTOM ROW: Your Original Copyright & Social Icons -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pt-2">
      <!-- LEFT SIDE: Copyright Statement Info -->
      <div class="text-sm tracking-tight text-slate-400 text-center md:text-left">
        &copy; {new Date().getFullYear()} JohnBrain. All rights reserved.
      </div>

      <!-- RIGHT SIDE: Social Links + Smooth Back To Top Button Box -->
      <div class="flex items-center gap-5">
        <!-- Facebook Link -->
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[#B7F000] transition-colors duration-200"
          aria-label="Facebook"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
          </svg>
        </a>

        <!-- X / Twitter Link -->
        <a
          href="https://x.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[#B7F000] transition-colors duration-200"
          aria-label="X (formerly Twitter)"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>

        <!-- LinkedIn Link -->
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[#B7F000] transition-colors duration-200"
          aria-label="LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
        </a>

        <!-- Divider element between social anchors and top arrow button -->
        <div class="h-4 w-px bg-slate-800 mx-1 hidden sm:block"></div>

        <!-- BACK TO TOP BUTTON -->
        <a
          href="#"
          class="flex items-center justify-center w-9 h-9 rounded-full border border-slate-700 text-slate-400 hover:text-[#B7F000] hover:border-[#B7F000] transition-all duration-300 transform hover:-translate-y-1 cursor-none"
          data-cursor="selectable"
          aria-label="Scroll Back to Top"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4.5 15.75l7.5-7.5 7.5 7.5"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
