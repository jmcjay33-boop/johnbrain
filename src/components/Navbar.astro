            class="px-3 py-2 rounded-lg hover:px-14 hover:transition-all hover:ease-in
             text-slate-300 hover:text-[#B7F000] before:content-[''] hover:before:content-['——_'] before:transition-all cursor-pointer"
            data-cursor="selectable"
          >
            Advisory, Wealth & Portfolio Services Linked to Digital Assets
          </a>
          <a
            href="/services/properties"
            class="px-3 py-2 rounded-lg hover:px-14 hover:transition-all hover:ease-in
             text-slate-300 hover:text-[#B7F000] before:content-[''] hover:before:content-['——_'] before:transition-all cursor-pointer"
            data-cursor="selectable"
