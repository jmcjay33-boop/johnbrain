        </button>

        <!-- Desktop Dropdown Menu (Vertical List) -->
        <div
          class="absolute left-0 mt-2 w-112.5 bg-[#36430b] shadow-md opacity-0
        invisible group-hover:opacity-100 group-hover:visible transition-all duration-1000 z-50
        font-semibold flex px-4 py-2 flex-col gap-1"
        >
          <a
            href="/about/company"
            class="px-3 py-2 rounded-lg hover:px-14 hover:transition-all hover:ease-in
             text-slate-300 hover:text-[#B7F000] before:content-['']
              hover:before:content-['——_'] before:transition-all cursor-pointer"
            data-cursor="selectable"
          >
            The Company
