        <a
          href="/services/acustody"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          Virtual Asset Custody & Wallet Services
        </a>
        <a
          href="/services/ainsurance"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          Digital Asset Issuance & Tokenisation Services
        </a>
        <a
          href="/services/atransfer"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          Virtual Asset Transfer & Payment Services
        </a>
        <a
          href="/services/awealth"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          Advisory, Wealth & Portfolio Services Linked to Digital Assets
        </a>
        <a
          href="/services/properties"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
