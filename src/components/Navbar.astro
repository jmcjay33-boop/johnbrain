          <a
            href="/services/compliance"
            class="px-3 py-2 rounded-lg hover:px-14 hover:transition-all hover:ease-in
             text-slate-300 hover:text-[#B7F000] before:content-[''] hover:before:content-['——_'] before:transition-all cursor-pointer"
            data-cursor="selectable"
          >
            Board of Directors
          </a>

          <a
            href="/services/compliance"
            class="px-3 py-2 rounded-lg hover:px-14 hover:transition-all hover:ease-in
             text-slate-300 hover:text-[#B7F000] before:content-[''] hover:before:content-['——_'] before:transition-all cursor-pointer"
            data-cursor="selectable"
          >
            Management Team
          </a>

          <a
            href="/services/ma"
            class="px-3 py-2 rounded-lg hover:transition-all hover:ease-in text-slate-300
             before:content-[''] hover:before:content-['——_'] before:transition-all
             hover:px-14 hover:text-[#B7F000] cursor-pointer"
            data-cursor="selectable"
