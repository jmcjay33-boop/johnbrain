      <div class="mobile-submenu-items hidden rounded-xl pl-4 border-l-2 border-slate-200 space-y-1 py-1 flex-col">
        <a
          href="/services/vasset"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white
           hover:bg-slate-100 hover:text-[#B7F000]"
        >
          Virtual Asset Exchange & Trading Services
