</header>

<script>
  // --- 1. Mobile Menu & Submenu Logic ---
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const menuPanel = document.getElementById('mobile-menu-panel');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  toggleBtn?.addEventListener('click', () => {
    const isPanelOpen = !menuPanel?.classList.contains('hidden');
    if (isPanelOpen) {
      menuPanel?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      menuPanel?.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });

  // Handles all mobile submenus (About Us, Services, etc.)
  const mobileSubmenuBtns = document.querySelectorAll('.mobile-submenu-btn');

  mobileSubmenuBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.mobile-submenu-group');
      const submenuItems = group?.querySelector('.mobile-submenu-items');
      const arrow = group?.querySelector('.mobile-submenu-arrow');

      const isSubmenuHidden = submenuItems?.classList.contains('hidden');
      if (isSubmenuHidden) {
        submenuItems?.classList.remove('hidden');
        arrow?.classList.add('rotate-180');
      } else {
        submenuItems?.classList.add('hidden');
        arrow?.classList.remove('rotate-180');
      }
    });
  });

  // --- 2. Navbar Background & Logo Shrink on Scroll ---
  const navbar = document.getElementById('main-navbar');
  const navbarLogo = document.getElementById('navbar-logo');

  const handleScroll = () => {
    if (!navbar) return;

    if (window.scrollY > 20) {
      navbar.classList.remove('bg-transparent');
      navbar.classList.add('bg-white', 'shadow-sm');

      navbarLogo?.classList.add(
        'h-18',
        'w-auto',
        'transition-all',
        'duration-300'
      );
    } else {
      navbar.classList.remove('bg-white', 'shadow-sm');
      navbar.classList.add('bg-transparent');

      navbarLogo?.classList.remove('h-18', 'w-auto');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>

<style>
  .logo-link img {
    width: 100;
    display: block;
  }
</style>
