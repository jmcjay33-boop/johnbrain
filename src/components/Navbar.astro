        </div>
      </div>
    </nav>

    <!-- 3. Right Section: Client Access (Desktop) + Mobile Hamburger -->
    <div class="flex items-center gap-4 shrink-0">
      <div class="hidden md:flex items-center gap-4">
        <div class="h-6 w-px bg-slate-200"></div>
        <a
          href="/clientele"
          class="inline-flex items-center gap-2 bg-slate-900
           hover:bg-[#B7F000] text-white hover:text-slate-950 border border-slate-800 hover:border-[#B7F000] font-semibold text-sm px-5 py-2.5 rounded-full shadow-sm transition-all duration-300 cursor-pointer"
          data-cursor="selectable"
        >
          <span>Client Access</span>
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Icon Button -->
      <button
        id="menu-toggle-btn"
        class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all cursor-pointer"
        data-cursor="selectable"
        aria-label="Toggle Navigation Menu"
      >
        <svg
          id="hamburger-icon"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
        <svg
          id="close-icon"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>
  </div>
  <!-- 4. Mobile Menu Drawer Panel -->
  <div
    id="mobile-menu-panel"
    class="hidden md:hidden bg-slate-800 absolute top-full left-0 w-full max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain z-40 px-4 py-4 pb-8 space-y-2 shadow-md"
  >
    <a
      href="/"
      class="block px-4 py-2.5 rounded-xl text-base font-bold text-white
       hover:bg-slate-50 hover:text-[#B7F000]"
    >
      Home
    </a>

    <!-- About Us Dropdown -->
    <div class="space-y-1 mobile-submenu-group">
      <button
        class="mobile-submenu-btn w-full flex items-center justify-between px-4 py-2.5
       rounded-xl text-base font-bold text-white hover:bg-slate-100 hover:text-[#B7F000]
        cursor-pointer"
      >
        <span>About Us</span>
        <svg
          class="mobile-submenu-arrow w-4 h-4 text-slate-400 transition-transform duration-150"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"
          ></path>
        </svg>
      </button>

      <div class="mobile-submenu-items hidden rounded-xl pl-4 border-l-2 border-slate-200 space-y-1 py-1 flex-col">
        <a
          href="/about/company"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          The Company
        </a>
        <a
          href="/services/compliance"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          Board of Directors
        </a>
        <a
          href="/services/compliance"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          Management Team
        </a>
        <a
          href="/services/ma"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          Contact Us
        </a>
      </div>
    </div>

    <!-- Subsidiaries Dropdown -->
    <div class="space-y-1 mobile-submenu-group">
      <button
        class="mobile-submenu-btn w-full flex items-center justify-between px-4 py-2.5
       rounded-xl text-base font-bold text-white hover:bg-slate-100 hover:text-[#B7F000] cursor-pointer"
      >
        <span>Subsidiaries</span>
        <svg
          class="mobile-submenu-arrow w-4 h-4 text-slate-400 transition-transform duration-150"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"
          ></path>
        </svg>
      </button>

      <div class="mobile-submenu-items hidden rounded-xl pl-4 border-l-2 border-slate-200 space-y-1 py-1 flex-col">
        <a
