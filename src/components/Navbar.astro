            Contact Us
          </a>
        </div>
      </div>
      <!-- Subsidiaries Dropdown -->
      <div class="relative group py-2">
        <button
          class="hover:text-[#B7F000] transition-colors flex items-center gap-1 cursor-pointer"
          data-cursor="selectable"
        >
          <a
            href="/subsidiaries/investment"
            class="hover:text-[#B7F000] transition-colors cursor-pointer"
            data-cursor="selectable"
