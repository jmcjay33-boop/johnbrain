---
import { Image } from 'astro:assets';
import logoImage from '../assets/jb-logo.svg';
---

<!-- src/components/Navbar.astro -->
<header
  id="main-navbar"
  class="w-full sticky top-0 pt-1.5 z-50 font-sans transition-colors duration-300 ease-in-out bg-transparent"
>
  <div class="max-w-7xl md:mx-11 px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- 1. Left Section: Logo -->
    <a href="/" class="logo-link transition-colors cursor-pointer shrink-0">
      <Image
        id="navbar-logo"
        src={logoImage}
        alt="Company Name Logo"
        loading="eager"
        data-cursor="selectable"
      />
    </a>

    <!-- 2. Middle Section: Centered Desktop Links -->
    <nav class="hidden md:flex items-center justify-center gap-8 font-semibold text-[17px]">
      <a
        href="/"
        class="hover:text-[#B7F000] transition-colors cursor-pointer"
        data-cursor="selectable"
      >
        Home
      </a>

