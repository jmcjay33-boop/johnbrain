        <a
          href="/subsidiaries/tokens"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          JohnBrain Tokens Limited
        </a>
        <a
          href="/subsidiaries/properties"
          class="block px-4 py-2 rounded-lg text-sm font-semibold text-white hover:bg-slate-100 hover:text-[#B7F000]"
        >
          JohnBrain Properties Limited
        </a>
      </div>
    </div>
    <!-- core services drop down -->
    <!-- Subsidiaries Dropdown -->
    <div class="space-y-1 mobile-submenu-group">
      <button
        class="mobile-submenu-btn w-full flex items-center justify-between px-4 py-2.5
       rounded-xl text-base font-bold text-white hover:bg-slate-100 hover:text-[#B7F000] cursor-pointer"
      >
        <span>Core Services</span>
        <svg
          class="mobile-submenu-arrow w-4 h-4 text-slate-400 transition-transform duration-150"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"
