---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'John Brain' } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <!-- Changed 'cursor-none' to 'md:cursor-none' so touchscreens retain normal touch behavior -->
  <body
    class="min-h-full bg-transparent text-slate-900 m-0 p-0 md:cursor-none selection:text-white relative"
  >
    <!-- 1A. THE GLOW BALL: Hidden on mobile/tablet ('hidden md:block') -->
    <div
      id="custom-glow-cursor"
      class="hidden md:block fixed top-0 left-0 w-2 h-2 bg-[#B7F000] rounded-full pointer-events-none
             -translate-x-1/2 -translate-y-1/2 transition-all duration-75 ease-out"
      style="z-index: 9999;"
    ></div>

    <!-- 1B. THE POINTER ARROW: Hidden on mobile/tablet ('hidden md:block') -->
    <div
      id="custom-cursor-arrow"
      class="hidden md:block fixed top-0 left-0 pointer-events-none transition-all duration-150 ease-out"
      style="z-index: 10000;"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="#B7F000"
        stroke="#0f172a"
        stroke-width="1.5"
        stroke-linejoin="round"
      >
        <path d="M4 2L20 11L12 13.5L9.5 21.5L4 2Z" />
      </svg>
    </div>

    <slot />

    <!-- 2. GLOBAL TRACKER ENGINE -->
    <script>
      const ball = document.getElementById('custom-glow-cursor');
      const arrow = document.getElementById('custom-cursor-arrow');

      // Detect if device has a fine pointer (mouse/trackpad) vs touch screen
      const isDesktopPointer = window.matchMedia('(pointer: fine)').matches;

      if (!isDesktopPointer) {
        // Completely remove cursor elements from touch screens (phones & iPads)
        ball?.remove();
        arrow?.remove();
      } else {
        window.addEventListener('mousemove', (e) => {
          if (ball) {
            ball.style.left = `${e.clientX}px`;
            ball.style.top = `${e.clientY}px`;
          }

          if (arrow) {
            arrow.style.left = `${e.clientX + 5}px`;
            arrow.style.top = `${e.clientY + 5}px`;
          }
        });

        document.addEventListener('mouseover', (e) => {
          const target = e.target as HTMLElement;
          const isSelectable = target?.closest('[data-cursor="selectable"]');

          if (isSelectable && ball) {
            arrow?.classList.add('opacity-0');
            ball.classList.remove('w-2', 'h-2', 'bg-[#B7F000]');
            ball.classList.add(
              'w-20',
              'h-20',
              'bg-[#B7F000]/20',
              'border',
              'border-[#B7F000]',
              'scale-110'
            );
          }
        });

        document.addEventListener('mouseout', (e) => {
          const target = e.target as HTMLElement;
          const leftSelectable = target?.closest('[data-cursor="selectable"]');

          if (leftSelectable && ball) {
            arrow?.classList.remove('opacity-0');
            ball.classList.remove(
              'w-20',
              'h-20',
              'bg-[#B7F000]/20',
              'border',
              'border-[#B7F000]',
              'scale-110'
            );
            ball.classList.add('w-2', 'h-2', 'bg-[#B7F000]');
          }
        });
      }
    </script>
  </body>
</html>

