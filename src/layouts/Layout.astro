---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'John Brain' } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <!-- NOTE: 'cursor-none' disables the default browser mouse arrow universally so our custom glow ball takes over completely -->
  <body
    class="min-h-full bg-transparent text-slate-900 m-0 p-0 cursor-none
	 selection:text-white relative"
  >
    <!-- 1A. THE GLOW BALL: Leads at the exact mouse coordinates and expands on hover -->
    <div
      id="custom-glow-cursor"
      class="fixed top-0 left-0 sm:w-2 sm:h-2 sm:bg-[#B7F000] rounded-full pointer-events-none
			 -translate-x-1/2 -translate-y-1/2 transition-all duration-75 ease-out"
      style="z-index: 9999;"
    ></div>

    <!-- 1B. THE POINTER ARROW: Positioned bottom-right of the glow ball so its tip points directly at it -->
    <div
      id="custom-cursor-arrow"
      class="fixed top-0 left-0 pointer-events-none transition-all duration-150 ease-out"
      style="z-index: 10000;"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="#B7F000"
        stroke="#0f172a"
        stroke-width="1.5"
        stroke-linejoin="round"
      >
        <path d="M4 2L20 11L12 13.5L9.5 21.5L4 2Z" />
      </svg>
    </div>

    <slot />

    <!-- 2. GLOBAL TRACKER ENGINE: Monitors global mouse coordinate changes and select hovering hooks -->
    <script>
      const ball = document.getElementById('custom-glow-cursor');
      const arrow = document.getElementById('custom-cursor-arrow');

      // Track active hardware pointer positioning values
      window.addEventListener('mousemove', (e) => {
        if (ball) {
          // Glow ball stays locked directly onto your exact cursor position
          ball.style.left = `${e.clientX}px`;
          ball.style.top = `${e.clientY}px`;
        }

        if (arrow) {
          // Offset bottom-right so the top-left arrow tip points straight at the glow ball and trails it
          arrow.style.left = `${e.clientX + 5}px`;
          arrow.style.top = `${e.clientY + 5}px`;
        }
      });

      // MONITOR HIGHLIGHT EXPANSION LOOPS:
      // We scan for elements explicitly marked with our dataset hook 'data-cursor="selectable"'
      document.addEventListener('mouseover', (e) => {
        const target = e.target as HTMLElement;
        const isSelectable = target?.closest('[data-cursor="selectable"]');

        if (isSelectable && ball) {
          arrow?.classList.add('opacity-0');

          // CUSTOMIZE MAGNIFIED BALL HERE:
          // Transitions small neon green ball into a wide transparent green halo ring over links
          ball.classList.remove('sm:w-2', 'sm:h-2', 'sm:bg-[#B7F000]');
          ball.classList.add(
            'sm:w-20',
            'sm:h-20',
            'sm:bg-[#B7F000]/20',
            'sm:border',
            'sm:border-[#B7F000]',
            'sm:scale-110'
          );
        }
      });

      // RESET BALANCING LOOPS: Reverts cursor properties back to normal scale when mouse exits hover focus
      document.addEventListener('mouseout', (e) => {
        const target = e.target as HTMLElement;
        const leftSelectable = target?.closest('[data-cursor="selectable"]');

        if (leftSelectable && ball) {
          arrow?.classList.remove('opacity-0');

          // Wipes out expanded hover utility styles and applies baseline Neon Green tracking dot
          ball.classList.remove(
            'sm:w-20',
            'sm:h-20',
            'sm:bg-[#B7F000]/20',
            'sm:border',
            'sm:border-[#B7F000]',
            'sm:scale-110'
          );
          ball.classList.add('sm:w-2', 'sm:h-2', 'sm:bg-[#B7F000]');
        }
      });
    </script>
  </body>
</html>
