---
import { Image } from 'astro:assets';
import johnPhoto from '../../assets/ja.jpeg'; // Make sure your photo filename matches here
import sundayPhoto from '../../assets/sa.jpeg'; // Make sure your photo filename matches here
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const teamMembers = [
  {
    id: 'John Sani Agbo.',
    name: 'John Sani Agbo.',
    role: 'Group Chief Executive Officer',

    hasPhoto: true,
    bio: [
      'John is a highly accomplished finance and investment professional, a Chartered Accountant, Chartered Stockbroker and Certified Pensions Expert, with over two decades of extensive experience across the financial services and capital markets sectors.',
      'His professional expertise encompasses corporate finance, investment banking, financial management and strategic investment advisory, with specialised competencies in securities trading, portfolio and wealth management, capital raising, and corporate financial strategy.',
      'Throughout his career, John has been instrumental in executing and facilitating several high-value and landmark financial transactions, including complex cross-border deals. He has also held senior financial management and corporate accounting positions within leading multinational organisations in the energy and telecommunications sectors, contributing to financial governance, strategic decision-making and corporate performance.',
      'His professional accomplishments are complemented by a strong academic and professional qualification record, distinguished by prestigious merit awards and recognitions from leading professional accounting and stockbroking institutions.',
      'John also serves as a Consultant to Fintec Africa LLC, a specialist advisory firm focused on supporting African fintech enterprises in accessing international capital, attracting strategic investments and strengthening their competitiveness in the global financial ecosystem.',
      'His combination of extensive capital markets experience, financial expertise, transaction execution capabilities and strategic advisory insight positions him as a seasoned professional at the intersection of traditional finance, investment banking and emerging financial technologies.',
    ],
  },
  {
    id: 'director-2',
    name: 'Executive Director',
    role: 'Director • Regulatory Compliance & Governance',
    hasPhoto: false,
    bio: [
      'Seasoned regulatory compliance and risk governance specialist with extensive experience advising digital asset firms, payment institutions, and capital market operators across Africa and international jurisdictions.',
      'Oversees licensing strategy, AML/CFT frameworks, and institutional governance standards.',
    ],
  },
  {
    id: 'director-3',
    name: 'Managing Director',
    role: 'Director • Digital Assets & Tokenisation',

    hasPhoto: false,
    bio: [
      'Specialises in blockchain-enabled capital markets infrastructure, real-world asset tokenisation, and institutional digital asset offerings.',
      'Leads product structuring and cross-border investor distribution.',
    ],
  },
  {
    id: 'Sunday Felicity Agbo',
    name: 'Sunday Felicity Agbo',
    role: 'Chief Technology Officer',

    hasPhoto: true,
    bio: [
      'Sunday Agbo is a distinguished technology executive, enterprise systems architect, and full-stack software engineer with over 15 years of extensive experience in technology leadership, financial-grade software engineering, enterprise infrastructure management, database administration, and cybersecurity.',
      'He possesses deep expertise in developing and managing sophisticated technology ecosystems, with particular specialisation in financial technology, digital asset infrastructure, enterprise systems architecture, and information security governance. His technical competencies span the design and implementation of high-performance backend systems, real-time transaction processing engines, secure database environments, and integrated web and mobile platforms, leveraging modern programming technologies including Rust, Go, TypeScript, and Flutter.',
      'Throughout his career, Sunday has demonstrated exceptional capacity for translating complex business and operational requirements into secure, scalable, and commercially viable technology solutions. He has provided strategic technology leadership across organisations, driving digital transformation, enterprise systems integration, infrastructure development, and cybersecurity initiatives. As a technology entrepreneur and co-founder, he has also led the conceptualisation, architecture, development, and deployment of production-grade technology platforms, including real-time telemetry, digital identity verification, and automated workflow management systems.',
      'His professional experience further encompasses senior IT infrastructure and enterprise systems management roles within the telecommunications, hospitality, and technology consulting sectors. In these capacities, he has overseen mission-critical network infrastructure, enterprise security environments, Active Directory administration, ERP systems, database operations, and corporate communications infrastructure, supporting the technology requirements of major corporate organisations.',
      'An Oracle Certified Associate (OCA) and a Computer Science graduate with an outstanding academic record, Sunday combines a strong technical and academic foundation with extensive practical experience in enterprise technology management and software development. His multidisciplinary capabilities, spanning executive-level technology governance and hands-on engineering execution, position him to provide effective leadership in the development and management of sophisticated digital financial infrastructures.',
      'His expertise is particularly valuable in ensuring that digital asset platforms, investor onboarding systems, transaction processing infrastructure, and enterprise data environments are designed and operated in accordance with international best practices for information security, regulatory compliance, operational resilience, and technological innovation.',
    ],
  },
];
---

<Layout title="Management Team | JohnBrain">
  <Navbar />

  <main class="w-full bg-slate-950 text-white font-sans mt-12">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-24 space-y-14">
      <!-- 1. PAGE HEADER -->
      <div class="border-b border-slate-800 pb-8 max-w-3xl">
        <p class="text-[#B7F000] font-bold text-xs sm:text-sm uppercase tracking-widest mb-3">
          LEADERSHIP & GOVERNANCE
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white tracking-tight leading-tight mb-4">
          Management Team
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Tap on any leadership profile below to view their full executive
          biography and credentials.
        </p>
      </div>

      <!-- 2. COMPACT TEAM CARDS GRID (Photo + Job Description Only) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {teamMembers.map((member) => (
          <button
            type="button"
            data-member-trigger={member.id}
            data-cursor="selectable"
            class="text-left bg-slate-900/70 border border-slate-800 hover:border-[#B7F000] rounded-3xl overflow-hidden shadow-xl transition-all duration-300 group flex flex-col justify-between cursor-pointer"
          >
            <div>
              <!-- Portrait Box -->
              <div class="relative w-full aspect-4/5 bg-slate-950 overflow-hidden border-b border-slate-800">
                {member.hasPhoto ? (
                  <Image
                    src={
                      member.id == 'John Sani Agbo.' ? johnPhoto : sundayPhoto
                    }
                    alt={member.name}
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                    loading="eager"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-slate-700 group-hover:text-slate-500 transition-colors">
                    <svg
                      class="w-20 h-20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
                      />
                    </svg>
                  </div>
                )}
              </div>

              <!-- Name & Job Title -->
              <div class="p-6 sm:p-7 space-y-2.5">
                <h2 class="text-2xl font-bold text-white group-hover:text-[#B7F000] transition-colors pt-1">
                  {member.name}
                </h2>
                <p class="text-slate-400 text-sm leading-relaxed">
                  {member.role}
                </p>
              </div>
            </div>

            <!-- Tap Prompt Footer -->
            <div class="px-6 sm:px-7 pb-6 pt-3 border-t border-slate-800/60 flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-400 group-hover:text-white transition-colors">
              <span>View Full Profile</span>
              <span class="text-[#B7F000] text-base group-hover:translate-x-1 transition-transform">
                →
              </span>
            </div>
          </button>
        ))}
      </div>
    </section>
    <!-- 3. FULL BIOGRAPHY DIALOG MODAL -->
    {teamMembers.map((member) => (
      <div
        id={`modal-${member.id}`}
        class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-slate-950/85 backdrop-blur-md"
        role="dialog"
        aria-modal="true"
      >
        <div class="relative w-full max-w-3xl max-h-[88vh] bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl flex flex-col overflow-hidden">
          <!-- Modal Top Bar with White X Close Button -->
          <div class="flex items-start justify-between gap-4 p-6 sm:p-8 border-b border-slate-800 bg-slate-950/60 shrink-0">
            <div>
              <p class="text-[#B7F000] font-bold text-xs uppercase tracking-widest mb-1">
                Executive Profile
              </p>
              <h3 class="text-2xl sm:text-3xl font-bold text-white">
                {member.name}
              </h3>
              <p class="text-slate-400 text-sm mt-1">{member.role}</p>
            </div>

            <!-- White X Close Button -->

            <button
              type="button"
              data-close-modal
              data-cursor="selectable"
              aria-label="Close profile dialog"
              class="w-10 h-10 rounded-full bg-slate-800 hover:bg-slate-700 border border-slate-700 flex items-center justify-center text-white transition-colors shrink-0 cursor-pointer"
            >
              <svg
                class="w-5 h-5 text-white"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
            </button>
          </div>

          <!-- Scrollable Full Biography Body -->
          <div class="p-6 sm:p-8 overflow-y-auto space-y-4 text-slate-300 text-base leading-relaxed">
            {member.bio.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    ))}
  </main>

  <Footer />
</Layout>

<script>
  const triggers = document.querySelectorAll('[data-member-trigger]');
  const closeButtons = document.querySelectorAll('[data-close-modal]');
  const modals = document.querySelectorAll('[id^="modal-"]');

  const closeAllModals = () => {
    modals.forEach((modal) => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });
    document.body.style.overflow = '';
  };

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-member-trigger');
      const targetModal = document.getElementById(`modal-${id}`);
      if (targetModal) {
        targetModal.classList.remove('hidden');
        targetModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  closeButtons.forEach((btn) => {
    btn.addEventListener('click', closeAllModals);
  });

  // Close when tapping the dark backdrop outside the dialog box
  modals.forEach((modal) => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeAllModals();
    });
  });

  // Close when pressing Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllModals();
  });
</script>
