
---
import transferBg from '../../assets/investment.jpg';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pillars = [
  {
    number: '01',
    tag: 'Direct & Mediated Settlement',
    title: 'Peer-to-Peer & Platform Transfers',
    description:
      'Facilitation of peer-to-peer and platform-mediated transfers of virtual assets.',
  },
  {
    number: '02',
    tag: 'Payment Rails & AML Compliance',
    title: 'Payments, Remittances & Value Transfer',
    description:
      'Integration of virtual-asset rails for payments, remittances, and value transfer (subject to applicable payment-system and anti-money-laundering rules).',
  },
];
---

<Layout title="Virtual Asset Transfer & Payment Services | JohnBrain">
  <Navbar />

  <main
    class="w-full min-h-screen text-white font-sans mt-12 bg-cover bg-center bg-fixed bg-no-repeat"
    style={`background-image: url(${transferBg.src});`}
  >
    <div class="w-full min-h-screen bg-slate-950/75">
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-24">
        <!-- 1. Editorial Hero Header -->
        <div class="bg-black/45 backdrop-blur-xs border border-white/20 rounded-2xl p-8 sm:p-12 mb-12">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
            <span class="text-[#B7F000] font-bold text-xs sm:text-sm uppercase tracking-widest">
              Core Services • Settlement &amp; Value Transfer
            </span>
            <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#B7F000]/15 text-[#B7F000] border border-[#B7F000]/30">
              AML &amp; Payment-System Compliant
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight max-w-4xl mb-6">
            Virtual Asset Transfer &amp; Payment Services
          </h1>

          <!-- Quick Settlement & Compliance Spec Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-white/15 text-sm">
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Transfer Channels</p>
              <p class="text-white font-semibold mt-1">P2P &amp; Platform-Mediated</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Use Cases</p>
              <p class="text-white font-semibold mt-1">Payments &amp; Remittances</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Infrastructure</p>
              <p class="text-white font-semibold mt-1">Virtual-Asset Rails</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Regulatory Standard</p>
              <p class="text-[#B7F000] font-semibold mt-1">Payment &amp; AML Rules</p>
            </div>
          </div>
        </div>

        <!-- 2. Two Balanced Feature Pillar Cards (Your Exact 2 Bullet Points) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          {pillars.map((item) => (
            <div class="bg-black/55 backdrop-blur-xs border border-white/20 hover:border-[#B7F000] rounded-2xl p-8 sm:p-10 flex flex-col justify-between transition-all duration-300 group">
              <div>
                <div class="flex items-center justify-between mb-6">
                  <span class="text-[#B7F000] font-bold text-2xl">
                    {item.number}.
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-white/10 text-slate-200">
                    {item.tag}
                  </span>
                </div>
                <h2 class="text-2xl font-bold text-white mb-4 group-hover:text-[#B7F000] transition-colors">
                  {item.title}
                </h2>
                <p class="text-slate-200 text-base sm:text-lg leading-relaxed">
                  {item.description}
                </p>
              </div>

              <div class="mt-8 pt-4 border-t border-white/10 flex items-center gap-2 text-xs font-semibold text-[#B7F000] uppercase tracking-wider">
                <span class="h-2 w-2 rounded-full bg-[#B7F000]"></span>
                <span>Compliant Value Transfer Rails</span>
              </div>
            </div>
          ))}
        </div>

        <!-- 3. Bottom Call-to-Action Banner -->
        <div class="bg-black/60 backdrop-blur-xs border border-white/20 rounded-2xl p-8 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <h3 class="text-2xl font-bold text-white mb-2">
              Fast, compliant digital asset transfers and settlements
            </h3>
            <p class="text-slate-300 text-base max-w-2xl">
              Connect to JOHNBRAIN's virtual-asset payment and remittance infrastructure built around strict payment-system and AML standards.
            </p>
          </div>
          <a
            href="/clientele"
            class="inline-flex items-center gap-2 bg-[#B7F000] hover:bg-[#a6da00] text-slate-950 font-bold text-sm px-6 py-3.5 rounded-full shrink-0 transition-all duration-300"
            data-cursor="selectable"
          >
            <span>Access Transfer Portal</span>
            <span>→</span>
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
