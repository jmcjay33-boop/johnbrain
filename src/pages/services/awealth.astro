---
import advisoryBg from '../../assets/investment.jpg';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pillars = [
  {
    number: '01',
    tag: 'Market Intelligence & Guidance',
    title: 'Research, Education & Advisory',
    description:
      'Research, education, and advisory services relating to virtual assets and digital-asset markets.',
  },
  {
    number: '02',
    tag: 'Risk-Managed Allocation',
    title: 'Portfolio Construction & Wealth Management',
    description:
      'Portfolio construction, risk assessment, and wealth-management products that incorporate digital assets (where permitted).',
  },
  {
    number: '03',
    tag: 'Private & Institutional Desk',
    title: 'Institutional & High-Net-Worth Exposure',
    description:
      'Support for institutional and high-net-worth clients seeking exposure to the digital-asset class.',
  },
];
---

<Layout title="Advisory, Wealth & Portfolio Services Linked to Digital Assets | JohnBrain">
  <Navbar />

  <main
    class="w-full min-h-screen text-white font-sans mt-12 bg-cover bg-center bg-fixed bg-no-repeat"
    style={`background-image: url(${advisoryBg.src});`}
  >
    <div class="w-full min-h-screen bg-slate-950/75">
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-24">
        <!-- 1. Editorial Hero Header -->
        <div class="bg-black/45 backdrop-blur-xs border border-white/20 rounded-2xl p-8 sm:p-12 mb-12">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
            <span class="text-[#B7F000] font-bold text-xs sm:text-sm uppercase tracking-widest">
              Core Services • Advisory &amp; Private Wealth
            </span>
            <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#B7F000]/15 text-[#B7F000] border border-[#B7F000]/30">
              Institutional &amp; HNW Solutions
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight max-w-4xl mb-6">
            Advisory, Wealth &amp; Portfolio Services Linked to Digital Assets
          </h1>

          <!-- Quick Advisory & Wealth Spec Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-white/15 text-sm">
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Insights</p>
              <p class="text-white font-semibold mt-1">Research &amp; Market Education</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Strategy</p>
              <p class="text-white font-semibold mt-1">Portfolio &amp; Risk Assessment</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Client Focus</p>
              <p class="text-white font-semibold mt-1">Institutional &amp; HNW Clients</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Governance</p>
              <p class="text-[#B7F000] font-semibold mt-1">Permitted Wealth Structures</p>
            </div>
          </div>
        </div>

        <!-- 2. Three Interactive Pillar Cards (Your Exact 3 Bullet Points) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
          {pillars.map((item) => (
            <div class="bg-black/55 backdrop-blur-xs border border-white/20 hover:border-[#B7F000] rounded-2xl p-8 flex flex-col justify-between transition-all duration-300 group">
              <div>
                <div class="flex items-center justify-between mb-6">
                  <span class="text-[#B7F000] font-bold text-2xl">
                    {item.number}.
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-white/10 text-slate-200">
                    {item.tag}
                  </span>
                </div>
                <h2 class="text-xl font-bold text-white mb-3 group-hover:text-[#B7F000] transition-colors">
                  {item.title}
                </h2>
                <p class="text-slate-200 text-base leading-relaxed">
                  {item.description}
                </p>
              </div>

              <div class="mt-8 pt-4 border-t border-white/10 flex items-center gap-2 text-xs font-semibold text-[#B7F000] uppercase tracking-wider">
                <span class="h-2 w-2 rounded-full bg-[#B7F000]"></span>
                <span>Tailored Portfolio Governance</span>
              </div>
            </div>
          ))}
        </div>

        <!-- 3. Bottom Call-to-Action Banner -->
        <div class="bg-black/60 backdrop-blur-xs border border-white/20 rounded-2xl p-8 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <h3 class="text-2xl font-bold text-white mb-2">
              Build disciplined digital asset exposure for your portfolio
            </h3>
            <p class="text-slate-300 text-base max-w-2xl">
              Engage JOHNBRAIN's advisory and wealth desk for research-backed portfolio structuring, risk assessment, and institutional digital asset access.
            </p>
          </div>
          <a
            href="/clientele"
            class="inline-flex items-center gap-2 bg-[#B7F000] hover:bg-[#a6da00] text-slate-950 font-bold text-sm px-6 py-3.5 rounded-full shrink-0 transition-all duration-300"
            data-cursor="selectable"
          >
            <span>Connect with Advisory Desk</span>
            <span>→</span>
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
