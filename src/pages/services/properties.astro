

---
import propertiesBg from '../../assets/real-estate.jpg';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pillars = [
  {
    number: '01',
    tag: 'Discovery & Matching',
    title: 'Property Search & Listing Platforms',
    description:
      'Online property search, listing, and matching platforms.',
  },
  {
    number: '02',
    tag: 'Paperless Execution',
    title: 'Digital Documentation & E-Signing',
    description:
      'Digital documentation and e-signing of sale, purchase, and lease agreements.',
  },
  {
    number: '03',
    tag: 'Automated Settlements',
    title: 'Electronic Payment Processing',
    description:
      'Electronic payment processing for deposits, purchase considerations, rents, and related fees.',
  },
  {
    number: '04',
    tag: 'Due Diligence & Registry',
    title: 'Digital Title Search & Verification',
    description:
      'Digital title search, verification, and status tracking.',
  },
  {
    number: '05',
    tag: 'Immersive Inspection',
    title: 'Virtual Tours & 3D/360° Viewing',
    description:
      'Virtual property tours and 3D/360° viewing tools.',
  },
  {
    number: '06',
    tag: 'Streamlined Deal Flow',
    title: 'Online Applications & Offer Workflows',
    description:
      'Online application, offer submission, and approval workflows.',
  },
  {
    number: '07',
    tag: 'Protected Funds',
    title: 'Digital Escrow & Fund-Holding',
    description:
      'Digital escrow and secure fund-holding arrangements.',
  },
  {
    number: '08',
    tag: 'End-to-End Closing',
    title: 'Electronic Conveyancing Support',
    description:
      'Electronic conveyancing support and transaction tracking.',
  },
  {
    number: '09',
    tag: 'Post-Closing Operations',
    title: 'Digital Tenancy Management',
    description:
      'Digital tenancy management (rent collection, renewals, and maintenance requests).',
  },
];
---

<Layout title="Properties Businesses | JohnBrain">
  <Navbar />

  <main
    class="w-full min-h-screen text-white font-sans mt-12 bg-cover bg-center bg-fixed bg-no-repeat"
    style={`background-image: url(${propertiesBg.src});`}
  >
    <div class="w-full min-h-screen bg-slate-950/75">
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-24">
        <!-- 1. Editorial Hero Header -->
        <div class="bg-black/45 backdrop-blur-xs border border-white/20 rounded-2xl p-8 sm:p-12 mb-12">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
            <span class="text-[#B7F000] font-bold text-xs sm:text-sm uppercase tracking-widest">
              Core Services • Digital Real Estate &amp; PropTech
            </span>
            <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#B7F000]/15 text-[#B7F000] border border-[#B7F000]/30">
              End-to-End Property Ecosystem
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight max-w-4xl mb-6">
            Properties Businesses
          </h1>

          <!-- Quick PropTech Highlights Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-white/15 text-sm">
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Discovery</p>
              <p class="text-white font-semibold mt-1">Listings &amp; 3D/360° Tours</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Verification</p>
              <p class="text-white font-semibold mt-1">Digital Title &amp; E-Signing</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Settlement</p>
              <p class="text-white font-semibold mt-1">Escrow &amp; Electronic Payments</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Management</p>
              <p class="text-[#B7F000] font-semibold mt-1">Tenancy &amp; Conveyancing</p>
            </div>
          </div>
        </div>

        <!-- 2. Nine Interactive Pillar Cards (3x3 Balanced Grid) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          {pillars.map((item) => (
            <div class="bg-black/55 backdrop-blur-xs border border-white/20 hover:border-[#B7F000] rounded-2xl p-8 flex flex-col justify-between transition-all duration-300 group">
              <div>
                <div class="flex items-center justify-between mb-6">
                  <span class="text-[#B7F000] font-bold text-2xl">
                    {item.number}.
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-white/10 text-slate-200">
                    {item.tag}
                  </span>
                </div>
                <h2 class="text-xl font-bold text-white mb-3 group-hover:text-[#B7F000] transition-colors">
                  {item.title}
                </h2>
                <p class="text-slate-200 text-base leading-relaxed">
                  {item.description}
                </p>
              </div>

              <div class="mt-8 pt-4 border-t border-white/10 flex items-center gap-2 text-xs font-semibold text-[#B7F000] uppercase tracking-wider">
                <span class="h-2 w-2 rounded-full bg-[#B7F000]"></span>
                <span>PropTech Enabled</span>
              </div>
            </div>
          ))}
        </div>

        <!-- 3. Bottom Call-to-Action Banner -->
        <div class="bg-black/60 backdrop-blur-xs border border-white/20 rounded-2xl p-8 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <h3 class="text-2xl font-bold text-white mb-2">
              Experience seamless, transparent real estate transactions
            </h3>
            <p class="text-slate-300 text-base max-w-2xl">
              Discover verified listings, digital escrow, e-signing, and automated tenancy management through JOHNBRAIN's digital property ecosystem.
            </p>
          </div>
          <a
            href="/clientele"
            class="inline-flex items-center gap-2 bg-[#B7F000] hover:bg-[#a6da00] text-slate-950 font-bold text-sm px-6 py-3.5 rounded-full shrink-0 transition-all duration-300"
            data-cursor="selectable"
          >
            <span>Explore Property Portal</span>
            <span>→</span>
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
