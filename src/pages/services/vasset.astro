

---
import exchangeBg from '../../assets/investment.jpg';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pillars = [
  {
    number: '01',
    tag: 'Fiat & Crypto Liquidity',
    title: 'Direct Asset Buying, Selling & Swaps',
    description:
      'Facilitation of buying, selling, and exchanging virtual assets (cryptocurrencies and other digital tokens) for fiat currency (primarily Naira) or other virtual assets.',
  },
  {
    number: '02',
    tag: 'Execution Infrastructure',
    title: 'Order-Matching & Brokerage Engine',
    description:
      'Operation of an order-matching or brokerage platform for clients.',
  },
  {
    number: '03',
    tag: 'Institutional & Retail Desk',
    title: 'Market Access & Price Discovery',
    description:
      'Provision of market access, price discovery, and execution services for retail and institutional clients.',
  },
];
---

<Layout title="Virtual Asset Exchange & Trading Services | JohnBrain">
  <Navbar />

  <main
    class="w-full min-h-screen text-white font-sans mt-12 bg-cover bg-center bg-fixed bg-no-repeat"
    style={`background-image: url(${exchangeBg.src});`}
  >
    <div class="w-full min-h-screen bg-slate-950/75">
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-24">
        <!-- 1. Editorial Hero Header -->
        <div class="bg-black/45 backdrop-blur-xs border border-white/20 rounded-2xl p-8 sm:p-12 mb-12">
          <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
            <span class="text-[#B7F000] font-bold text-xs sm:text-sm uppercase tracking-widest">
              Core Services • Trading &amp; Liquidity
            </span>
            <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#B7F000]/15 text-[#B7F000] border border-[#B7F000]/30">
              NGN &amp; Multi-Asset Pairs
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight max-w-4xl mb-6">
            Virtual Asset Exchange &amp; Trading Services
          </h1>

          <!-- Quick Visual Highlights Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-white/15 text-sm">
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Primary Settlement</p>
              <p class="text-white font-semibold mt-1">Nigerian Naira (NGN)</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Execution Model</p>
              <p class="text-white font-semibold mt-1">Order-Matching &amp; OTC</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Client Tiers</p>
              <p class="text-white font-semibold mt-1">Retail &amp; Institutional</p>
            </div>
            <div>
              <p class="text-slate-400 text-xs uppercase tracking-wider">Pricing</p>
              <p class="text-[#B7F000] font-semibold mt-1">Real-Time Discovery</p>
            </div>
          </div>
        </div>

        <!-- 2. Three Interactive Pillar Cards (Your Exact 3 Bullet Points) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
          {pillars.map((item) => (
            <div class="bg-black/55 backdrop-blur-xs border border-white/20 hover:border-[#B7F000] rounded-2xl p-8 flex flex-col justify-between transition-all duration-300 group">
              <div>
                <div class="flex items-center justify-between mb-6">
                  <span class="text-[#B7F000] font-bold text-2xl">
                    {item.number}.
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-white/10 text-slate-200">
                    {item.tag}
                  </span>
                </div>
                <h2 class="text-xl font-bold text-white mb-3 group-hover:text-[#B7F000] transition-colors">
                  {item.title}
                </h2>
                <p class="text-slate-200 text-base leading-relaxed">
                  {item.description}
                </p>
              </div>

              <div class="mt-8 pt-4 border-t border-white/10 flex items-center gap-2 text-xs font-semibold text-[#B7F000] uppercase tracking-wider">
                <span class="h-2 w-2 rounded-full bg-[#B7F000]"></span>
                <span>Regulated Execution Framework</span>
              </div>
            </div>
          ))}
        </div>

        <!-- 3. Bottom Call-to-Action Banner -->
        <div class="bg-black/60 backdrop-blur-xs border border-white/20 rounded-2xl p-8 sm:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <h3 class="text-2xl font-bold text-white mb-2">
              Ready to access digital asset liquidity?
            </h3>
            <p class="text-slate-300 text-base max-w-2xl">
              Onboard seamlessly as a retail or institutional client to execute Naira-to-crypto and digital asset trades with transparent pricing.
            </p>
          </div>
          <a
            href="/clientele"
            class="inline-flex items-center gap-2 bg-[#B7F000] hover:bg-[#a6da00] text-slate-950 font-bold text-sm px-6 py-3.5 rounded-full shrink-0 transition-all duration-300"
            data-cursor="selectable"
          >
            <span>Start Trading via Client Access</span>
            <span>→</span>
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
