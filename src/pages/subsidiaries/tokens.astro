---
import homebg from "../../assets/token.webp";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const activities = [
  "Digital asset offering and fundraising platforms.",
  "Tokenisation of eligible real-world assets, including real estate, commodities, infrastructure and other investment assets.",
  "Structuring and facilitation of digital investment offerings.",
  "Development and administration of token subscription and distribution platforms.",
  "Investor onboarding, verification and subscription processing.",
  "Digital representation of eligible financial and investment instruments.",
  "Coordination of token issuance, allocation and distribution.",
  "Provision of digital asset offering administration and post-issuance reporting.",
  "Facilitation of capital raising for businesses, project developers and institutional sponsors.",
  "Development of blockchain-enabled solutions for digital securities and investment products.",
];
---

<Layout title="JohnBrain Tokens Limited">
  <Navbar />

  <main
    class="w-full min-h-screen text-white font-sans mt-12 bg-cover bg-center bg-fixed bg-no-repeat"
    style={`background-image: url(${homebg.src});`}
  >
    <!-- Very light dark tint (only 25%) so your red image stays vivid while white text stays readable -->
    <div class="w-full min-h-screen bg-black/25">
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-24">
        <!-- Top Header & Intro Sentence sitting directly on the image -->
        <div class="pb-6 mb-8 border-b border-white/25">
          <p class="text-[#B7F000] font-bold text-xs sm:text-sm uppercase tracking-widest mb-3 drop-shadow">
            JOHNBRAIN TOKENS LIMITED
          </p>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight max-w-4xl mb-4 drop-shadow">
            Digital Asset Issuance, Tokenisation and Capital-Raising Platform
          </h1>
          <p class="text-lg sm:text-xl text-white font-normal leading-relaxed max-w-4xl mb-4 drop-shadow">
            This subsidiary concentrate on digital asset fundraising, tokenisation and the development and operation of digital platforms through which businesses, institutions and eligible project sponsors can raise capital.
          </p>
          <p class="text-base sm:text-lg text-[#B7F000] font-semibold drop-shadow">
            Its proposed activities include:
          </p>
        </div>

        <!-- Listed Items (01 to 10) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {activities.map((item, index) => (
            <div class="bg-black/45 backdrop-blur-xs border border-white/20 hover:border-[#B7F000] rounded-2xl p-6 sm:p-8 transition-colors duration-300 flex items-start gap-5">
              <span class="text-[#B7F000] font-bold text-lg sm:text-xl shrink-0">
                {String(index + 1).padStart(2, "0")}.
              </span>
              <p class="text-white text-base sm:text-lg font-normal leading-relaxed">
                {item}
              </p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
